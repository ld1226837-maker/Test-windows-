<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Only needed on Android 9 and older; API 29+ writes through MediaStore,
         which requires no runtime permission at all. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 11 (API 30) hides other installed apps from us unless we
         declare what we want to talk to. Without this, queryIntentActivities /
         Intent.resolveActivity for a PDF returns nothing even when a PDF
         viewer is installed, so the "open the saved bill" fallback used by
         openUri()/openFile() (and the ACTION_VIEW chooser after Print falls
         back) silently did nothing. Printing itself goes through
         PrintManager and needs no visibility declaration; this is only for
         the fallback path. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="content" />
        </intent>
    </queries>


    <application>
        <!-- Backs FileProvider.getUriForFile(..., "${applicationId}.androidsave.fileprovider", ...)
             in AndroidSavePlugin.openFile(), used only on API <= 28 to open a saved
             file via ACTION_VIEW after save/print/share. Without this declaration the
             call throws, openFile() swallows it and falls back to Uri.fromFile(), and
             the resulting intent silently fails to resolve. API 29+ opens via the
             MediaStore content:// URI directly and doesn't need this.

             Uses AndroidSaveFileProvider (a real, always-present subclass of
             FileProvider — see that file's kdoc) rather than the raw
             androidx.core.content.FileProvider class. The app's own
             auto-generated manifest also declares a <provider> naming the raw
             FileProvider class for its own "${applicationId}.fileprovider"
             authority; the manifest merger matches <provider> entries by
             android:name, not by authority, so two entries naming the same raw
             class collide and fail the merge even though their authorities
             differ. Giving this one a distinct class name avoids that. -->
        <provider
            android:name="app.tauri.androidsave.AndroidSaveFileProvider"
            android:authorities="${applicationId}.androidsave.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/android_save_file_paths"
                tools:replace="android:resource" />
        </provider>
    </application>
</manifest>
