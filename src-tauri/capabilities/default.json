{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.telegram.org/**" }]
    },
    "fs:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-open",
    "fs:allow-read",
    "fs:allow-seek",
    "fs:allow-fstat",
    "fs:allow-stat",
    "fs:allow-read-dir",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$DOCUMENT/TurfApp/**"
        },
        {
          "path": "$DOWNLOAD/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://wa.me/**" },
        { "url": "https://wa.me/*" },
        { "url": "https://api.whatsapp.com/**" },
        { "url": "tel:*" },
        { "url": "sms:*" },
        { "url": "mailto:*" },
        {
          "url": "upi://**"
        }
      ]
    },
    "opener:allow-reveal-item-in-dir"
  ]
}